# Public WPGraphQL endpoint for the WordPress backend.
# Example: https://cms.example.com/graphql
WP_GRAPHQL_URL=https://example.com/graphql

# Base WP REST URL (no plugins required). Theme Options + content pages
# come from /wp-json/wpas/v1/options and /wp-json/wp/v2/* respectively.
# Example: https://cms.example.com/wp-json
WP_REST_URL=https://example.com/wp-json

# Public site URL used by Astro for sitemap / canonical links.
SITE_URL=https://example.com

# Optional auth token if your WPGraphQL endpoint is protected.
# WP_GRAPHQL_TOKEN=
