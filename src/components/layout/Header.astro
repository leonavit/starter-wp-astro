---
import { siteConfig } from "../../config/site";

const nav = siteConfig.nav;
const { phone, phoneDisplay } = siteConfig.business;
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="border-b border-slate-200 bg-white sticky top-0 z-50">
  <div class="container-prose flex items-center justify-between gap-3 py-3 sm:py-4">
    <a href="/" class="font-bold text-lg sm:text-xl text-slate-900 no-underline shrink-0">
      {siteConfig.name}
    </a>

    <!-- Desktop nav -->
    <nav aria-label="ניווט ראשי" class="hidden md:block">
      <ul class="flex items-center gap-5 lg:gap-7 list-none m-0 p-0">
        {nav.map((item) => {
          const isActive = pathname === item.href || (item.href !== "/" && pathname.startsWith(item.href));
          return (
            <li>
              <a
                href={item.href}
                class:list={[
                  "no-underline text-base font-medium transition-colors",
                  isActive ? "text-brand-700" : "text-slate-700 hover:text-brand-700",
                ]}
                aria-current={isActive ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <!-- Desktop phone CTA -->
      <a
        href={`tel:${phone}`}
        class="hidden md:inline-flex items-center gap-2 bg-brand-700 hover:bg-brand-900 text-white px-4 py-2 rounded-lg text-sm font-medium no-underline transition-colors"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.05-.24c1.16.39 2.41.6 3.69.6a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A18 18 0 0 1 3 4a1 1 0 0 1 1-1h3.46a1 1 0 0 1 1 1c0 1.27.21 2.53.6 3.69a1 1 0 0 1-.25 1.05l-2.19 2.05z"/>
        </svg>
        <span dir="ltr">{phoneDisplay}</span>
      </a>

      <!-- Mobile phone (icon only) -->
      <a
        href={`tel:${phone}`}
        aria-label={`התקשרו ל-${phoneDisplay}`}
        class="md:hidden w-10 h-10 rounded-lg bg-brand-700 text-white flex items-center justify-center no-underline"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.05-.24c1.16.39 2.41.6 3.69.6a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A18 18 0 0 1 3 4a1 1 0 0 1 1-1h3.46a1 1 0 0 1 1 1c0 1.27.21 2.53.6 3.69a1 1 0 0 1-.25 1.05l-2.19 2.05z"/>
        </svg>
      </a>

      <!-- Mobile hamburger -->
      <button
        id="nav-toggle"
        class="md:hidden relative w-10 h-10 flex flex-col items-center justify-center gap-1.5"
        aria-label="פתח תפריט"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span id="hb-1" class="block w-6 h-0.5 bg-slate-900 rounded transition-transform duration-300 origin-center"></span>
        <span id="hb-2" class="block w-6 h-0.5 bg-slate-900 rounded transition-opacity duration-300"></span>
        <span id="hb-3" class="block w-6 h-0.5 bg-slate-900 rounded transition-transform duration-300 origin-center"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile drawer (sibling of header, escapes the header's stacking context) -->
<nav
  id="mobile-nav"
  aria-label="ניווט נייד"
  aria-hidden="true"
  class="md:hidden fixed inset-x-0 bottom-0 top-[57px] sm:top-[65px] bg-white z-40 overflow-y-auto invisible opacity-0 -translate-y-2 transition-all duration-300"
>
  <ul class="container-prose flex flex-col gap-0 list-none m-0 p-0 pt-6">
    {nav.map((item, i) => {
      const isActive = pathname === item.href || (item.href !== "/" && pathname.startsWith(item.href));
      return (
        <li class="mobile-nav-item opacity-0 translate-y-3 transition-all duration-300" style={`transition-delay: ${i * 50}ms`}>
          <a
            href={item.href}
            class:list={[
              "block py-4 px-2 text-xl font-medium no-underline border-b border-slate-100 transition-colors",
              isActive ? "text-brand-700" : "text-slate-800 hover:text-brand-700",
            ]}
            aria-current={isActive ? "page" : undefined}
          >
            {item.label}
          </a>
        </li>
      );
    })}
  </ul>
</nav>

<script>
  const btn = document.getElementById("nav-toggle");
  const drawer = document.getElementById("mobile-nav");
  const hb1 = document.getElementById("hb-1");
  const hb2 = document.getElementById("hb-2");
  const hb3 = document.getElementById("hb-3");

  function setOpen(open: boolean) {
    if (!btn || !drawer || !hb1 || !hb2 || !hb3) return;

    btn.setAttribute("aria-expanded", String(open));
    btn.setAttribute("aria-label", open ? "סגור תפריט" : "פתח תפריט");
    drawer.setAttribute("aria-hidden", String(!open));

    drawer.classList.toggle("invisible", !open);
    drawer.classList.toggle("opacity-0", !open);
    drawer.classList.toggle("-translate-y-2", !open);
    drawer.classList.toggle("opacity-100", open);
    drawer.classList.toggle("translate-y-0", open);

    drawer.querySelectorAll<HTMLElement>(".mobile-nav-item").forEach((el) => {
      el.classList.toggle("opacity-0", !open);
      el.classList.toggle("translate-y-3", !open);
      el.classList.toggle("opacity-100", open);
      el.classList.toggle("translate-y-0", open);
    });

    hb1.style.transform = open ? "translateY(8px) rotate(45deg)" : "";
    hb2.style.opacity = open ? "0" : "";
    hb3.style.transform = open ? "translateY(-8px) rotate(-45deg)" : "";

    document.body.style.overflow = open ? "hidden" : "";
  }

  if (btn && drawer) {
    btn.addEventListener("click", () => {
      setOpen(btn.getAttribute("aria-expanded") !== "true");
    });
    drawer.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).tagName === "A") setOpen(false);
    });
  }
</script>
