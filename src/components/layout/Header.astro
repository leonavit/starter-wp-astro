---
const nav = [
  { href: "/", label: "בית" },
  { href: "/about", label: "אודות" },
  { href: "/services", label: "שירותים" },
  { href: "/contact", label: "צור קשר" },
];

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="border-b border-slate-200 bg-white/80 backdrop-blur sticky top-0 z-50">
  <div class="container-prose flex items-center justify-between py-4">
    <a href="/" class="font-bold text-xl text-slate-900 no-underline">
      WP × Astro
    </a>
    <nav aria-label="ניווט ראשי">
      <ul class="flex items-center gap-4 sm:gap-6 list-none m-0 p-0">
        {nav.map((item) => {
          const isActive = pathname === item.href || (item.href !== "/" && pathname.startsWith(item.href));
          return (
            <li>
              <a
                href={item.href}
                class:list={[
                  "no-underline text-sm sm:text-base font-medium",
                  isActive ? "text-brand-700" : "text-slate-700 hover:text-brand-700",
                ]}
                aria-current={isActive ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>
