---
import { siteConfig } from "../../config/site";
import { getThemeOptions } from "../../lib/wp-options";

const options = await getThemeOptions();
const { nav, legalNav } = siteConfig;
const { contact, social, general } = options;

const year = new Date().getFullYear();
const yearRange = general.foundingYear && general.foundingYear < year
  ? `${general.foundingYear}–${year}`
  : `${year}`;

