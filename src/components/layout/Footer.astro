---
import { siteConfig } from "../../config/site";

const { business, social, nav, legalNav } = siteConfig;
const year = new Date().getFullYear();
const yearRange = business.foundingYear && business.foundingYear < year
  ? `${business.foundingYear}–${year}`
  : `${year}`;

const socials = [
  { key: "facebook", label: "Facebook", href: social.facebook, icon: "M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.99 22 12Z" },
  { key: "instagram", label: "Instagram", href: social.instagram, icon: "M12 2.163c3.204 0 3.584.012 4.85.07 1.366.062 2.633.336 3.608 1.311.975.975 1.249 2.242 1.311 3.608.058 1.266.069 1.646.069 4.85s-.011 3.584-.069 4.85c-.062 1.366-.336 2.633-1.311 3.608-.975.975-2.242 1.249-3.608 1.311-1.266.058-1.646.069-4.85.069-3.204 0-3.584-.011-4.85-.069-1.366-.062-2.633-.336-3.608-1.311-.975-.975-1.249-2.242-1.311-3.608C2.175 15.747 2.163 15.367 2.163 12s.012-3.584.07-4.85c.062-1.366.336-2.633 1.311-3.608.975-.975 2.242-1.249 3.608-1.311 1.266-.058 1.646-.07 4.848-.07Zm0 1.838c-3.142 0-3.515.012-4.755.068-.93.042-1.435.197-1.77.328a2.97 2.97 0 0 0-1.082.703 2.97 2.97 0 0 0-.703 1.082c-.131.335-.286.84-.328 1.77-.057 1.24-.068 1.612-.068 4.755 0 3.142.012 3.515.068 4.755.042.93.197 1.435.328 1.77a2.97 2.97 0 0 0 .703 1.082c.302.302.673.546 1.082.703.335.131.84.286 1.77.328 1.24.057 1.612.068 4.755.068 3.142 0 3.515-.012 4.755-.068.93-.042 1.435-.197 1.77-.328a2.97 2.97 0 0 0 1.082-.703 2.97 2.97 0 0 0 .703-1.082c.131-.335.286-.84.328-1.77.057-1.24.068-1.612.068-4.755 0-3.142-.012-3.515-.068-4.755-.042-.93-.197-1.435-.328-1.77a2.97 2.97 0 0 0-.703-1.082 2.97 2.97 0 0 0-1.082-.703c-.335-.131-.84-.286-1.77-.328-1.24-.056-1.612-.068-4.755-.068Zm0 3.135a4.864 4.864 0 1 1 0 9.728 4.864 4.864 0 0 1 0-9.728Zm0 8.027a3.163 3.163 0 1 0 0-6.326 3.163 3.163 0 0 0 0 6.326Zm6.184-8.222a1.137 1.137 0 1 1-2.274 0 1.137 1.137 0 0 1 2.274 0Z" },
  { key: "linkedin", label: "LinkedIn", href: social.linkedin, icon: "M4.98 3.5C4.98 4.881 3.87 6 2.5 6S.02 4.881.02 3.5C.02 2.12 1.13 1 2.5 1s2.48 1.12 2.48 2.5ZM.22 8h4.56v14H.22V8Zm7.32 0h4.37v1.91h.062c.609-1.15 2.097-2.37 4.318-2.37 4.62 0 5.47 3.04 5.47 6.99V22h-4.56v-6.5c0-1.55-.027-3.54-2.157-3.54-2.16 0-2.49 1.69-2.49 3.43V22H7.54V8Z" },
].filter((s) => s.href && !s.href.includes("your-"));
---

<footer class="bg-slate-900 text-slate-300 mt-16">
  <div class="container-prose py-12 sm:py-16 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
    <!-- Brand -->
    <div>
      <p class="text-white font-bold text-lg m-0">{siteConfig.name}</p>
      <p class="mt-3 text-sm leading-relaxed text-slate-400">{siteConfig.description}</p>

      {socials.length > 0 && (
        <div class="flex gap-3 mt-5">
          {socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener"
              aria-label={s.label}
              class="w-9 h-9 rounded-full bg-slate-800 hover:bg-brand-700 flex items-center justify-center text-slate-300 hover:text-white transition-colors no-underline"
            >
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d={s.icon} />
              </svg>
            </a>
          ))}
        </div>
      )}
    </div>

    <!-- Quick links -->
    <div>
      <p class="text-white font-semibold text-sm uppercase tracking-wider m-0">ניווט</p>
      <ul class="mt-4 space-y-2 list-none p-0">
        {nav.map((item) => (
          <li>
            <a href={item.href} class="text-slate-400 hover:text-white no-underline text-sm">{item.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Contact -->
    <div>
      <p class="text-white font-semibold text-sm uppercase tracking-wider m-0">צור קשר</p>
      <ul class="mt-4 space-y-2 list-none p-0 text-sm">
        <li>
          <a href={`tel:${business.phone}`} class="text-slate-400 hover:text-white no-underline" dir="ltr">
            {business.phoneDisplay}
          </a>
        </li>
        <li>
          <a href={`mailto:${business.email}`} class="text-slate-400 hover:text-white no-underline">
            {business.email}
          </a>
        </li>
        <li class="text-slate-400">
          {business.address.street}, {business.address.city}
        </li>
      </ul>
    </div>

    <!-- Hours -->
    <div>
      <p class="text-white font-semibold text-sm uppercase tracking-wider m-0">שעות פתיחה</p>
      <ul class="mt-4 space-y-2 list-none p-0 text-sm text-slate-400">
        {business.hours.map((h) => (
          <li class="flex justify-between gap-3">
            <span class="font-medium text-slate-300">{h.days}</span>
            <span dir="ltr">{h.time}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-slate-800">
    <div class="container-prose py-5 flex flex-col sm:flex-row gap-3 items-center justify-between text-xs text-slate-500">
      <p class="m-0">© {yearRange} {business.legalName}. כל הזכויות שמורות.</p>
      <ul class="flex flex-wrap gap-4 list-none p-0 m-0">
        {legalNav.map((item) => (
          <li>
            <a href={item.href} class="text-slate-500 hover:text-white no-underline">{item.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>
