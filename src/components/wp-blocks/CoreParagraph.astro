---
/**
 * Standalone renderer for a Gutenberg `core/paragraph` block.
 * Useful if you build a structured block renderer instead of dumping
 * raw HTML through `WpContent.astro`.
 */
interface Props {
  text: string;
  align?: "left" | "center" | "right";
}

const { text, align = "right" } = Astro.props;

const alignClass = {
  left: "text-left",
  center: "text-center",
  right: "text-right",
}[align];
---

<p class:list={["text-base sm:text-lg leading-7 my-4", alignClass]} set:html={text} />
