---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getAllContent } from "../lib/wp";

const all = await getAllContent();
const posts = all
  .filter((n) => n.__typename === "Post")
  .sort((a, b) => (b.date ?? "").localeCompare(a.date ?? ""));

function readingTime(html: string): string {
  const words = html.replace(/<[^>]+>/g, " ").split(/\s+/).filter(Boolean).length;
  const minutes = Math.max(1, Math.round(words / 220));
  return `${minutes} דק׳ קריאה`;
}

function formatDate(d?: string): string {
  if (!d) return "";
  return new Date(d).toLocaleDateString("he-IL", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<BaseLayout title="הבלוג שלנו" description="מאמרים, טיפים ועדכונים מצוות החברה.">
  <section class="container-prose py-10 sm:py-16">
    <header class="mb-8 sm:mb-12 text-center">
      <h1 class="text-3xl sm:text-5xl font-bold text-slate-900">הבלוג שלנו</h1>
      <p class="mt-3 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto">
        מאמרים מקצועיים, מדריכים פרקטיים ועדכוני תעשייה — הכל במקום אחד.
      </p>
    </header>

    {posts.length === 0 ? (
      <p class="text-center text-slate-500 py-12">עדיין אין פוסטים. חזרו בקרוב!</p>
    ) : (
      <ul class="grid gap-6 sm:gap-8 sm:grid-cols-2 lg:grid-cols-3 list-none p-0">
        {posts.map((post) => (
          <li>
            <a
              href={`/${post.uri}`}
              class="group block bg-white border border-slate-200 hover:border-brand-200 hover:shadow-lg rounded-2xl overflow-hidden transition-all no-underline h-full"
            >
              {post.featuredImage?.url && (
                <img
                  src={post.featuredImage.url}
                  alt={post.featuredImage.alt}
                  class="w-full aspect-video object-cover"
                  loading="lazy"
                />
              )}
              <div class="p-5 sm:p-6">
                <div class="flex items-center gap-2 text-xs text-slate-500">
                  {post.date && <time datetime={post.date}>{formatDate(post.date)}</time>}
                  <span aria-hidden="true">•</span>
                  <span>{readingTime(post.content)}</span>
                </div>
                <h2 class="mt-2 text-xl font-bold text-slate-900 group-hover:text-brand-700 transition-colors">
                  {post.title}
                </h2>
                {post.excerpt && (
                  <p class="mt-2 text-sm text-slate-600 leading-relaxed line-clamp-3"
                     set:html={post.excerpt.replace(/<[^>]+>/g, "")} />
                )}
                <p class="mt-4 text-sm font-medium text-brand-700">קרא עוד ←</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
