---
import BaseLayout from "./BaseLayout.astro";
import WpContent from "../components/WpContent.astro";
import type { WpNode } from "../lib/wp";

interface Props {
  node: WpNode;
}

const { node } = Astro.props;
---

<BaseLayout
  title={node.seo?.title ?? node.title}
  description={node.seo?.description}
  ogImage={node.seo?.ogImage ?? node.featuredImage?.url}
>
  <article class="container-prose py-8 sm:py-14">
    <header class="mb-6 sm:mb-8">
      <h1 class="text-2xl sm:text-4xl font-bold text-slate-900">{node.title}</h1>
    </header>
    {node.featuredImage?.url && (
      <img
        src={node.featuredImage.url}
        alt={node.featuredImage.alt}
        class="w-full rounded-2xl mb-8"
        loading="lazy"
      />
    )}
    <WpContent content={node.content} />
  </article>
</BaseLayout>
